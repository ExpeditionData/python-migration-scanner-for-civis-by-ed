# Copy this file to .env and replace the placeholder values.
# .env is ignored by git. Never commit real values.
#
# Local development uses synthetic test data only. Do not put a Civis API key
# here: the scanner and the app never call a real Civis instance from a local
# machine. Inside Civis, the Service and the scanner job get CIVIS_API_KEY from
# Civis automatically.

# Flask secret for running the app locally against test data (32+ characters).
# Inside Civis, the app derives its secret from the Service's API key instead.
FLASK_SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters

# Flask debug mode is never allowed. The app refuses to start if FLASK_DEBUG is set.

# Base URL of the Civis Platform web interface, used to build links to objects.
# Leave unset to use the standard address.
# CIVIS_PLATFORM_URL=https://platform.civisanalytics.com

# Space-separated https origins allowed to show the app in a frame, in addition
# to the app itself. Leave unset to allow Civis Platform only.
# CIVIS_FRAME_ANCESTORS=https://platform.civisanalytics.com

# Web app settings. Inside Civis these are Service environment variables, not
# secrets. Local preview (python -m app.local) does not use them.
# SCANNER_JOB_ID=12345
# RESULTS_DATABASE=your-database-name
# RESULTS_SCHEMA=your_results_schema
# RESULTS_CREDENTIAL_ID=
